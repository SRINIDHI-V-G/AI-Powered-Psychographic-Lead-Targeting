# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
# Local:  postgresql+asyncpg://postgres:password@localhost:5432/psycholead
# Railway: copy the connection string from your Railway PostgreSQL service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/psycholead

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of your Ollama server (local or Oracle VM)
# Local:       http://localhost:11434
# Oracle VM:   http://<your-oracle-vm-ip>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for motivation generation
OLLAMA_MODEL=llama3.1:8b

# ── App ───────────────────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
