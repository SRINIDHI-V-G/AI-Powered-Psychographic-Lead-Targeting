# ═══════════════════════════════════════════════════════════════════════════════
# PSYCHOGRAPHIC LEAD TARGETING — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Local:   postgresql+asyncpg://postgres:password@localhost:5432/psycholead
# Railway: copy the connection string from your Railway PostgreSQL service
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/psycholead

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Ollama / LLM ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300.0
SIMILAR_PRODUCTS_LLM_TIMEOUT=120.0

# false = call Ollama for all LLM stages (motivations, similar products, OCEAN)
# true  = skip Ollama and use template/heuristic data (for development without GPU)
USE_MOCK_LLM=false

# false = surface Ollama failures as product.status=failed (recommended for production)
# true  = silently fall back to template data on Ollama failure (masks real errors)
FALLBACK_TO_MOCK_ON_ERROR=false

# ── Discovery ─────────────────────────────────────────────────────────────────
# false = use real provider (Reddit / YouTube / Instagram) when credentials set
# true  = always use MockDiscoveryProvider regardless of credentials
MOCK_DISCOVERY=false

DISCOVERY_MAX_USERS=25
DISCOVERY_CONTENT_PER_USER=10
DISCOVERY_CONTENT_BATCH_SIZE=10

# ── Reddit Discovery ──────────────────────────────────────────────────────────
# Register at: https://reddit.com/prefs/apps (type: script, read-only)
# Recommended provider — text-rich content, best OCEAN signal quality.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:PsychographicLeads:1.0 (by u/your_username)

# ── YouTube Discovery ─────────────────────────────────────────────────────────
# Enable YouTube Data API v3 at: https://console.cloud.google.com
# Also install: pip install google-api-python-client
YOUTUBE_API_KEY=

# ── Instagram Discovery ───────────────────────────────────────────────────────
# Use a DEDICATED account — do NOT use your personal Instagram account.
# Session-ID login (recommended): get sessionid from browser DevTools
#   → Application → Cookies → instagram.com → sessionid
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_ID=
INSTAGRAM_SESSION_FILE=instagram_session.json
INSTAGRAM_MAX_POSTS_PER_HASHTAG=10
INSTAGRAM_MAX_COMMENTS_PER_POST=20

# ── Similar Products ──────────────────────────────────────────────────────────
SIMILAR_PRODUCTS_MAX=5
SIMILAR_PRODUCT_SIMILARITY_THRESHOLD=0.55

# ── Celery (optional — requires Redis) ───────────────────────────────────────
# Enable for distributed processing. Disabled by default (asyncio background tasks).
USE_CELERY=false
REDIS_URL=
